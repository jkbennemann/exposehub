# Settings of a Docker Compose install. ./install.sh copies this file to .env
# and fills it in; rerunning it keeps what is already set. Change a value
# here and run `docker compose up -d --wait` to apply it.
#
# Secrets are generated by install.sh. Never change APP_KEY on a running
# install: it signs everyone out and makes two-factor secrets unreadable.

# full: dashboard, accounts and request logs (profile "dashboard").
# tunnels: only the tunnel server, with the tokens in EXPOSEHUB_STATIC_TOKENS.
EXPOSEHUB_STACK=full
COMPOSE_PROFILES=dashboard

# --- Names -------------------------------------------------------------------
# The dashboard, e.g. exposehub.example.com.
EXPOSEHUB_DASHBOARD_HOST=
# Tunnels get <name>.<this domain>; agents connect to connect.<this domain>.
# Best on a registrable domain of its own, e.g. example-tunnels.net.
EXPOSEHUB_TUNNEL_DOMAIN=

# --- Certificates ------------------------------------------------------------
# dns: one wildcard certificate over the DNS challenge (set EXPOSEHUB_DNS_PROVIDER
#      and its credentials in caddy.env).
# on-demand: a certificate per tunnel name on its first visit, no DNS access needed.
# internal: Caddy's own local authority, for testing on a laptop.
EXPOSEHUB_TLS_MODE=dns
# cloudflare, hetzner, route53, digitalocean, ovh, gandi, porkbun, desec,
# ionos or netcup; see caddy/dns/.
EXPOSEHUB_DNS_PROVIDER=
# Let's Encrypt writes here about certificates that are about to expire.
EXPOSEHUB_ACME_EMAIL=
# true lets the tunnel server approve certificates for live tunnel names
# (set by install.sh for the on-demand mode).
EXPOSEHUB_TLS_ASK_TUNNEL_NAMES=false
# With that, how many new tunnel names get a certificate per window: in total
# under the tunnel domain, and per team. Let's Encrypt issues 50 new
# certificates per domain and week; the total stays below that, and the
# per-team limit below the total, so no team can use them all up. Defaults:
# 40 in total and 10 per team per 168h (a week). A total of 0 means no limit,
# only for a CA or a Let's Encrypt exemption that allows more.
# EXPOSEHUB_TLS_ASK_TOTAL_LIMIT=40
# EXPOSEHUB_TLS_ASK_NAME_LIMIT=10
# EXPOSEHUB_TLS_ASK_NAME_WINDOW=168h

# --- Dashboard ---------------------------------------------------------------
# Platform owners, comma separated: verified accounts with these addresses
# are admins that cannot be locked out.
EXPOSEHUB_ADMIN_EMAILS=
# Email domains accounts are limited to, comma separated. Empty lets anyone
# on the internet register and open tunnels on your server.
EXPOSEHUB_ALLOWED_EMAIL_DOMAINS=
# Allowed domains that are never named on a page.
EXPOSEHUB_HIDDEN_EMAIL_DOMAINS=
# Named in mails about deleted or changed accounts. Optional.
EXPOSEHUB_CONTACT_EMAIL=
# Days request logs are kept.
EXPOSEHUB_LOG_RETENTION_DAYS=7
# Single sign-on over OpenID Connect (Okta, Entra ID, Google Workspace,
# Keycloak, ...). On once the issuer, the client and at least one domain are
# set; accounts of these domains then sign in through the provider only, and
# EXPOSEHUB_ADMIN_EMAILS keep their password. Register
# https://<dashboard>/sso/callback as the redirect address. See docs/admin.md.
# EXPOSEHUB_SSO_ISSUER=https://example.okta.com
# EXPOSEHUB_SSO_CLIENT_ID=
# EXPOSEHUB_SSO_CLIENT_SECRET=
# EXPOSEHUB_SSO_DOMAINS=example.com
# EXPOSEHUB_SSO_NAME=Okta
# Days agent tokens work after the last sign-in through the provider (0: for good):
# EXPOSEHUB_SSO_TOKEN_DAYS=30
# EXPOSEHUB_SSO_REQUIRE_VERIFIED_EMAIL=true
# The demo: "Try the demo" on the landing page signs a visitor in without an
# account, into a team with sample data, where they can open real tunnels.
# All of it is deleted every EXPOSEHUB_DEMO_RESET_MINUTES. Off by default;
# read docs/admin.md before switching it on.
# EXPOSEHUB_DEMO=false
# EXPOSEHUB_DEMO_RESET_MINUTES=30
# Visitors until the next reset, starts per address an hour, tokens per visitor:
# EXPOSEHUB_DEMO_MAX_VISITORS=200
# EXPOSEHUB_DEMO_VISITORS_PER_IP_PER_HOUR=6
# EXPOSEHUB_DEMO_TOKENS_PER_VISITOR=2
# How much one person or team may set up (0 allows none). Defaults below.
# Teams one person owns:
# EXPOSEHUB_MAX_TEAMS_PER_USER=10
# Saved addresses one person keeps, across all their teams:
# EXPOSEHUB_MAX_SAVED_ADDRESSES_PER_USER=25
# Networks and own domains of one team:
# EXPOSEHUB_MAX_NETWORKS_PER_TEAM=25
# EXPOSEHUB_MAX_DOMAINS_PER_TEAM=25
# Sign-ups per IP address and hour (each mails a confirmation link). Everyone
# behind one shared office address counts together; raise it if many of you
# sign up at once:
# EXPOSEHUB_MAX_REGISTRATIONS_PER_IP_PER_HOUR=5
# Password-reset mails per hour, per IP address and per email address:
# EXPOSEHUB_MAX_PASSWORD_RESET_LINKS_PER_IP_PER_HOUR=10
# EXPOSEHUB_MAX_PASSWORD_RESET_LINKS_PER_ADDRESS_PER_HOUR=3
# Guessing limits, per account. Keep each at 1 or more: 0 would lock
# everyone out. Wrong passwords per minute from a signed-in session (password
# confirmation, account deletion, password change):
# EXPOSEHUB_MAX_PASSWORD_CHECKS_PER_MINUTE=5
# Two-factor codes per sign-in, per minute and per day:
# EXPOSEHUB_MAX_TWO_FACTOR_ATTEMPTS_PER_MINUTE=5
# EXPOSEHUB_MAX_TWO_FACTOR_ATTEMPTS_PER_DAY=20
# Wrong codes in a row before the sign-in starts over with the password and
# the account holder gets a mail about it:
# EXPOSEHUB_MAX_TWO_FACTOR_FAILURES_IN_A_ROW=5

# --- Mail --------------------------------------------------------------------
# log writes mails to the web container's log (docker compose logs web);
# smtp sends them. Registration needs working mail, as addresses are verified.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- Tunnel server -----------------------------------------------------------
# "account:token" pairs, comma separated, accepted besides dashboard tokens.
# The only tokens in the tunnels-only stack.
EXPOSEHUB_STATIC_TOKENS=
# Empty in the tunnels-only stack.
EXPOSEHUB_CONTROL_PLANE_URL=http://web:8080
# How long dashboard tokens keep working while the server cannot reach the
# dashboard. After that their tunnels close until it is back, so a revoked
# token cannot stay in use; static tokens keep working. 0 means forever.
# EXPOSEHUB_CONTROL_PLANE_MAX_STALE=5m
# How long a name stays reserved after its agent disconnects.
EXPOSEHUB_GRACE_PERIOD=1m
# Tunnels of the dashboard's demo account, which visitors use without signing
# up: how many may be open at once (0 for none), and how many requests each
# answers a minute. They only matter while the dashboard's demo is on.
# EXPOSEHUB_DEMO_MAX_TUNNELS=20
# EXPOSEHUB_DEMO_REQUESTS_PER_MINUTE=60
# How much data each carries a minute, both directions together, in megabytes:
# EXPOSEHUB_DEMO_MEGABYTES_PER_MINUTE=5
# off keeps no request summaries for the dashboard's request log.
EXPOSEHUB_REQUEST_LOGS=on
EXPOSEHUB_LOG_LEVEL=info
# text writes key=value lines, json one JSON object per line.
EXPOSEHUB_LOG_FORMAT=text
# Name=Value pairs added to every response on a team's own domain.
EXPOSEHUB_CUSTOM_DOMAIN_HEADERS=

# --- Secrets (generated by install.sh) ---------------------------------------
APP_KEY=
EXPOSEHUB_NODE_SECRET=
DB_PASSWORD=

# --- Host --------------------------------------------------------------------
# Ports Caddy publishes. Anything but 80 and 443 is for testing: Let's
# Encrypt only reaches 80 and 443.
EXPOSEHUB_HTTP_PORT=80
EXPOSEHUB_HTTPS_PORT=443
# ":<port>" when EXPOSEHUB_HTTPS_PORT is not 443, so links carry the port.
EXPOSEHUB_PORT_SUFFIX=
# The Docker network of Caddy, the tunnel server and the dashboard. Change
# both together if the subnet collides with one of yours.
EXPOSEHUB_SUBNET=172.30.53.0/24
EXPOSEHUB_CADDY_ADDRESS=172.30.53.10

# Only for testing another build: the registry and version of all images.
# Leave unset, so checking out a newer release upgrades the images too.
# EXPOSEHUB_REGISTRY=ghcr.io/jkbennemann
# EXPOSEHUB_VERSION=0.2.0
