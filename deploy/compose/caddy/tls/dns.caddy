# One wildcard certificate for *.<tunnel domain>, from Let's Encrypt over the
# DNS challenge, through the provider in dns/<EXPOSEHUB_DNS_PROVIDER>.caddy.
# The dashboard gets its own certificate over HTTP.

(tls_tunnels) {
	tls {
		import /etc/caddy/dns/{$EXPOSEHUB_DNS_PROVIDER}.caddy
	}
}

(tls_dashboard) {
	# The dashboard is only ever served over HTTPS with a certificate browsers
	# trust, so browsers may refuse plain HTTP for it from now on. Without
	# includeSubDomains: names under the dashboard's host are not ours to
	# promise anything about.
	header Strict-Transport-Security "max-age=31536000"
}

(tls_custom) {
	tls {
		on_demand
	}
}

# Every site refuses requests Docker relayed from inside the edge network;
# see (refuse_relayed) in the Caddyfile.
(edge_guard) {
	import refuse_relayed
}
