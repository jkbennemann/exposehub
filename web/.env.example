APP_NAME=exposehub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The address agents connect to, shown in the commands the dashboard suggests.
EXPOSEHUB_AGENT_SERVER=https://connect.example.com
# The domain tunnels get subdomains of, shown in examples.
EXPOSEHUB_TUNNEL_DOMAIN=example.com
# Shared secret between this app and the tunnel server. The internal API stays
# closed while this is empty. Generate one with: openssl rand -hex 32
EXPOSEHUB_NODE_SECRET=
# Comma-separated email domains accounts are limited to. Empty lets anyone register.
EXPOSEHUB_ALLOWED_EMAIL_DOMAINS=
# Allowed domains never named on a page or in an error message.
EXPOSEHUB_HIDDEN_EMAIL_DOMAINS=
# Platform owners, comma separated: verified accounts with these addresses are
# admins that cannot be demoted or locked out. They can make others admins.
EXPOSEHUB_ADMIN_EMAILS=
# The host teams point their own domains at with a CNAME record.
# Defaults to the host of EXPOSEHUB_AGENT_SERVER.
EXPOSEHUB_CUSTOM_DOMAIN_TARGET=
# Reverse proxies in front of this app (addresses or CIDRs, comma-separated, or *).
EXPOSEHUB_TRUSTED_PROXIES=
# What sets up certificates for teams' own domains: none, or kubernetes
# (one Ingress per domain; see config/exposehub.php).
EXPOSEHUB_DOMAIN_PROVISIONER=none
# Contact address named in mails about deleted or changed accounts. Optional.
EXPOSEHUB_CONTACT_EMAIL=
# Days request logs are kept before they are deleted.
EXPOSEHUB_LOG_RETENTION_DAYS=7
# How much one person or team may set up (0 allows none; empty keeps the
# default shown). Every team's networks and domains go to the tunnel server
# in one shared token list, so no single account may grow them without bound.
# Teams one person owns:
# EXPOSEHUB_MAX_TEAMS_PER_USER=10
# Saved addresses one person keeps, across all their teams:
# EXPOSEHUB_MAX_SAVED_ADDRESSES_PER_USER=25
# Networks of one team:
# EXPOSEHUB_MAX_NETWORKS_PER_TEAM=25
# Own domains of one team:
# EXPOSEHUB_MAX_DOMAINS_PER_TEAM=25
# Mail the dashboard sends to an address someone types in, per hour. Sign-ups
# per IP address (each mails a confirmation link); everyone behind one shared
# office address counts together, so raise it if many of you sign up at once:
# EXPOSEHUB_MAX_REGISTRATIONS_PER_IP_PER_HOUR=5
# Password-reset mails per IP address, and per email address:
# EXPOSEHUB_MAX_PASSWORD_RESET_LINKS_PER_IP_PER_HOUR=10
# EXPOSEHUB_MAX_PASSWORD_RESET_LINKS_PER_ADDRESS_PER_HOUR=3
# Guessing limits, per account. Keep each at 1 or more: 0 would lock
# everyone out. Wrong passwords per minute from a signed-in session (password
# confirmation, account deletion, password change):
# EXPOSEHUB_MAX_PASSWORD_CHECKS_PER_MINUTE=5
# Two-factor codes per sign-in, per minute and per day:
# EXPOSEHUB_MAX_TWO_FACTOR_ATTEMPTS_PER_MINUTE=5
# EXPOSEHUB_MAX_TWO_FACTOR_ATTEMPTS_PER_DAY=20
# Wrong codes in a row before the sign-in starts over with the password and
# the account holder gets a mail about it:
# EXPOSEHUB_MAX_TWO_FACTOR_FAILURES_IN_A_ROW=5
# Where the source code of what this installation runs can be found; the
# footer links here with the running version. Point it at your fork if you run
# a changed version, or leave it empty to hide the link.
EXPOSEHUB_SOURCE_URL=https://github.com/jkbennemann/exposehub
# The version shown next to that link. Release images set it themselves.
# EXPOSEHUB_VERSION=dev
