<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
{{- if .Refresh}}
<meta http-equiv="refresh" content="{{.Refresh}}">
{{- end}}
<title>{{.Title}}</title>
<style>
:root {
    --ink: #15173d;
    --paper: #f5f6f9;
    --text: #15173d;
    --muted: #696e8a;
    --line: #d9dce6;
    --cable: #ffc531;
    --cable-text: #8a6400;
    --fault: #e5484d;
    --box: #15173d;
    --box-text: #ebedf2;
    color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
    :root {
        --paper: #15173d;
        --text: #ebedf2;
        --muted: #9197ae;
        --line: #2f3260;
        --cable-text: #ffc531;
        --box: #0d0f2b;
    }
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
    min-height: 100vh;
    background: var(--paper);
    color: var(--text);
    font: 400 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
}
main {
    width: min(36rem, 100% - 2rem);
    margin: 0 auto;
    padding: clamp(3rem, 16vh, 9rem) 0 3rem;
}
.cable { display: block; width: 100%; height: auto; overflow: visible; }
.cable .wire { stroke: var(--cable); stroke-width: 5; stroke-linecap: round; fill: none; }
.cable .jack { fill: var(--cable); }
.cable .far { opacity: .35; }
.cable .socket { fill: none; stroke: var(--muted); stroke-width: 2.5; stroke-dasharray: 4 5; }
.cable .broken { fill: var(--paper); stroke: var(--fault); stroke-width: 4; }
.cable .cross { stroke: var(--fault); stroke-width: 3; stroke-linecap: round; }
.cable .lock rect.back { fill: var(--paper); }
.cable .lock .body { fill: var(--cable); }
.cable .lock .shackle { fill: none; stroke: var(--cable); stroke-width: 3.5; stroke-linecap: round; }
.cable .lock .hole { fill: var(--ink); }
.cable .returning { fill: none; stroke: var(--cable); stroke-width: 3; animation: return 1.6s ease-in-out infinite; }
@keyframes return { 50% { opacity: .2; } }
@media (prefers-reduced-motion: reduce) { .cable .returning { animation: none; } }
.ends {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .5rem;
    font-size: .8125rem;
    color: var(--muted);
}
.ends span:last-child { text-align: right; }
.host {
    margin: 3rem 0 0;
    font: 500 .9375rem/1.4 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: var(--cable-text);
    overflow-wrap: anywhere;
}
h1 {
    margin: .5rem 0 0;
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 2.75rem);
    line-height: 1.08;
    font-weight: 650;
    letter-spacing: -.02em;
    text-wrap: balance;
}
p { margin: 1rem 0 0; max-width: 34rem; }
.hint { color: var(--muted); }
.command {
    display: block;
    margin-top: .5rem;
    padding: .75rem 1rem;
    border-radius: .375rem;
    background: var(--box);
    color: var(--box-text);
    font: 400 .9375rem/1.5 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    overflow-wrap: anywhere;
    user-select: all;
}
.detail {
    font: 400 .8125rem/1.5 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: var(--muted);
    overflow-wrap: anywhere;
}
footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .8125rem;
    color: var(--muted);
}
footer svg { width: 1.75rem; height: auto; }
</style>
</head>
<body>
<main>
    <svg class="cable" viewBox="0 0 560 40" aria-hidden="true">
    {{- if eq .Cable "gap"}}
        <path class="wire" d="M20 20H246"/>
        <path class="wire far" d="M314 20H530"/>
        <circle class="jack" cx="12" cy="20" r="10"/>
        <circle class="returning" cx="548" cy="20" r="9"/>
    {{- else if eq .Cable "loose"}}
        <path class="wire" d="M20 20H300"/>
        <circle class="jack" cx="12" cy="20" r="10"/>
        <circle class="socket" cx="548" cy="20" r="10"/>
    {{- else if eq .Cable "fault"}}
        <path class="wire" d="M20 20H534"/>
        <circle class="jack" cx="12" cy="20" r="10"/>
        <circle class="broken" cx="548" cy="20" r="10"/>
        <path class="cross" d="M543 15l10 10M553 15l-10 10"/>
    {{- else}}
        <path class="wire" d="M20 20H540"/>
        <circle class="jack" cx="12" cy="20" r="10"/>
        <circle class="jack" cx="548" cy="20" r="10"/>
        <g class="lock">
            <rect class="back" x="258" y="0" width="44" height="40"/>
            <path class="shackle" d="M272 18v-6a8 8 0 0 1 16 0v6"/>
            <rect class="body" x="265" y="17" width="30" height="21" rx="3"/>
            <circle class="hole" cx="280" cy="27" r="2.5"/>
        </g>
    {{- end}}
    </svg>
    <div class="ends" aria-hidden="true"><span>you</span><span>the computer behind this address</span></div>

    <p class="host">{{.Host}}</p>
    <h1>{{.Title}}</h1>
    <p>{{.Text}}</p>
    {{- if .Command}}
    <p class="hint">{{.Hint}}</p>
    <code class="command">{{.Command}}</code>
    {{- end}}
    {{- if .Detail}}
    <p class="detail">{{.Detail}}</p>
    {{- end}}

    <footer>
        <span>{{.Status}} {{.StatusTx}}</span>
        <svg viewBox="0 0 32 16" aria-label="exposehub" role="img"><path d="M6 8h20" stroke="#ffc531" stroke-width="3.5" stroke-linecap="round"/><circle cx="5" cy="8" r="4" fill="#ffc531"/><circle cx="27" cy="8" r="4" fill="#ffc531"/></svg>
    </footer>
</main>
</body>
</html>
